@boundary(crypto)
module SecretNoBranch {
    // A `Secret` wraps a value that must never be observable through a branch,
    // memory-access pattern, or index derived from its bits. The verifier checks
    // that every operation on a `Secret` has an execution trace independent of
    // the value.
    invariant Secret {
        // The invariant is preserved trivially by construction; the security
        // property is the *absence* of secret-dependent control flow, expressed
        // in `ensures` below.
        true
    }

    // `expose` yields a reference to the secret. It performs no comparison,
    // branch, or indexed access on the secret bits, so the operation's execution
    // trace does not depend on the value being exposed.
    func expose(s: Secret)
        requires true
        ensures execution_trace is independent of s.value
    {
        mutate state { }
    }
}
